<Server port="-1">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener"/>
  <Service name="Catalina" gracefulStopAwaitMillis="30000">
    <Listener className="local.poc.AjpDrainListener"/>
    <Connector port="8080" protocol="HTTP/1.1" bindOnInit="false" connectionTimeout="30000"/>
    <Connector port="8009" protocol="AJP/1.3" keepAliveTimeout="1000" address="0.0.0.0" secret="${POC_AJP_SECRET}" secretRequired="true" bindOnInit="false" maxThreads="200"/>
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" unpackWARs="true" autoDeploy="false">
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs" prefix="access" suffix=".log" pattern="%t %s %D %{X-Request-ID}i"/>
      </Host>
    </Engine>
  </Service>
</Server>
